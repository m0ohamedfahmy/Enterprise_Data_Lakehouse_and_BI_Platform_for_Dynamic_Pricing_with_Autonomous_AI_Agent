# Copy to .env and fill in. Values here are also settable as CLI flags
# (CLI flags win) — see `python lakehouse_ai_agent.py --help`.

# --- Airflow / Astro ---
# Root webserver URL only — no /api/v1 or /api/v2 suffix. The agent
# auto-detects Airflow 2.x (basic auth) vs 3.x (JWT via /auth/token).
AIRFLOW_BASE_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin
DAG_ID=lakehouse_pipeline
# Static API token generated from the Airflow UI. When set, takes priority
# over username/password and is used as a Bearer token.
AIRFLOW_API_TOKEN=eyJhbGciOiJIUzUxMiIsImtpZCI6Im5vdC11c2VkIiwidHlwIjoiSldUIn0.eyJzdWIiOiJBbm9ueW1vdXMiLCJyb2xlIjoiQURNSU4iLCJ0ZWFtcyI6W10sImp0aSI6IjgwNTkzYTk0ZDFhYTQ4NGFhMTVhOTY1YzJiZTI2ZDhkIiwiYXVkIjoiYXBhY2hlLWFpcmZsb3ciLCJuYmYiOjE3ODc1NjQ2NDMsImV4cCI6MTc4NzY1MTA0MywiaWF0IjoxNzg3NTY0NjQzfQ.3-axpmlGNInSea0UvG45qt9EqyHhwLJ6NpX4NadH5tfnjghjiwiaeaVzX9SjoaElMgDHXsZEgaiEtTFdzY9CaQ
# Uncomment to force a version instead of auto-detecting (1 or 2):
#AIRFLOW_API_VERSION=1

# --- Nessie ---
NESSIE_URI=http://localhost:19120/api/v1
NESSIE_DEFAULT_BRANCH=main

# --- MinIO / S3 (Iceberg warehouse data only) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password
MINIO_MODEL_BUCKET=warehouse
# --- ML artifacts (pricing-api container volumes, NOT MinIO) ---
# Matches: pricing-models:/app/models, pricing-output:/app/output
PRICING_API_CONTAINER=pricing-api
PRICING_MODELS_PATH=/app/models
PRICING_OUTPUT_PATH=/app/output

# --- GroqCloud ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=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
# Verify these model IDs are still current: https://console.groq.com/docs/models
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_CODE_MODEL=openai/gpt-oss-120b

# --- Agent behavior ---
POLL_INTERVAL_SECONDS=30
AUTO_HEAL=false
MAX_AUTO_RETRIES=1
LOG_TAIL_LINES=200
RCA_OUTPUT_DIR=./rca_reports

# --- Script source directories (Mandatory Operational Sequence, Step 3) ---
# Explicit, per-stage roots the agent is allowed to read a *single* failing
# script from once a task failure has been classified as script-level (see
# lakehouse_agent/diagnostics/script_resolver.py). The agent never searches
# or reads outside these roots.
#
# Root dir for Spark/Python ingestion scripts run by DockerOperator tasks
# whose stage is "ingestion" (task_id contains ingest/spark/nessie).
INGESTION_SCRIPTS_DIR=/home/ninja/lakehouse-docker/lakehouse/scripts
# Root of the dbt project (models/, seeds/, macros/) for tasks whose stage
# is "transformation" (task_id contains dbt/transform).
DBT_PROJECT_DIR=/home/ninja/lakehouse-docker/airflow/dbt
# Root dir for ML training/inference scripts for tasks whose stage is
# "ml_training" or "ml_inference" (task_id contains train/fit_model/infer/
# score/predict).
ML_SCRIPTS_DIR=/home/ninja/lakehouse-docker/ml
# Secondary root, searched alongside INGESTION_SCRIPTS_DIR, for standalone
# spark-submit job files (as opposed to plain Python ingestion scripts).


# --- Shadow Code Generation (Step 4) ---
# Corrected scripts are written here, timestamped, and are NEVER written
# back over the original file under INGESTION_SCRIPTS_DIR / DBT_PROJECT_DIR
# / ML_SCRIPTS_DIR. recommended_action stays "alert_only" for any diagnosis
# that produced a shadow fix — nothing here is ever auto-applied.
RECOMMENDED_FIXES_DIR=./recommended_fixes
