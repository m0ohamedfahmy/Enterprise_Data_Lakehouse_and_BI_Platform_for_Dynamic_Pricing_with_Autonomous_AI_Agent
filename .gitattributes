# See https://help.github.com/articles/dealing-with-large-files/ for more information about Git LFS.
*.jar filter=lfs diff=lfs merge=lfs -text

# Exclude generated HTML files and reports from repository language stats
*.html linguist-vendored
*.htm linguist-vendored
*.html linguist-generated
*.htm linguist-generated

# Vendor specific directories (dbt artifacts, coverage, docs)
dbt/target/** linguist-vendored
htmlcov/** linguist-vendored
docs/** linguist-vendored