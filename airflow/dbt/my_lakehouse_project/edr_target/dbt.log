CE(b.dbt_valid_to, CAST('9999-12-31' AS DATE))\\n    AND COALESCE(a.dbt_valid_to, CAST('9999-12-31' AS DATE)) > b.dbt_valid_from\", \"other\": null, \"test_name\": \"assert_dim_products_no_overlapping_scd2_windows\", \"test_params\": \"{}\", \"severity\": \"ERROR\", \"status\": \"pass\", \"execution_time\": 4.562867, \"days_diff\": 0, \"invocations_rank_index\": 1, \"failures\": 0, \"result_rows\": null, \"sample_data\": null}, {\"id\": \"9c0fdba5-a38b-4743-9737-b420ee59c725.test.my_lakehouse_project.assert_dimension_match_rate\", \"invocation_id\": \"9c0fdba5-a38b-4743-9737-b420ee59c725\", \"test_execution_id\": \"9c0fdba5-a38b-4743-9737-b420ee59c725.test.my_lakehouse_project.assert_dimension_match_rate\", \"model_unique_id\": \"model.my_lakehouse_project.fact_store_sales\", \"test_unique_id\": \"test.my_lakehouse_project.assert_dimension_match_rate\", \"elementary_unique_id\": \"test.my_lakehouse_project.assert_dimension_match_rate.None.singular\", \"detected_at\": \"2026-08-17T12:23:50\", \"database_name\": \"nessie\", \"schema_name\": \"gold\", \"table_name\": \"fact_store_sales\", \"column_name\": null, \"test_type\": \"dbt_test\", \"test_sub_type\": \"singular\", \"test_results_description\": null, \"test_description\": null, \"original_path\": \"tests/singular/fact_store_sales/assert_dimension_match_rate.sql\", \"package_name\": \"my_lakehouse_project\", \"owners\": \"[]\", \"model_owner\": \"[]\", \"tags\": \"[\\\"fact_store_sales\\\", \\\"full_test\\\", \\\"fact_store_sales\\\", \\\"unmatched_products\\\"]\", \"test_tags\": \"[\\\"fact_store_sales\\\", \\\"unmatched_products\\\"]\", \"model_tags\": \"[\\\"fact_store_sales\\\", \\\"full_test\\\"]\", \"meta\": \"{}\", \"model_meta\": \"{}\", \"test_results_query\": \"\\nWITH stats AS (\\n    SELECT\\n        COUNT(*) AS total_rows,\\n        SUM(CASE WHEN product_key = '-1' THEN 1 ELSE 0 END) AS unmatched_products,\\n        SUM(CASE WHEN store_key = '-1' THEN 1 ELSE 0 END) AS unmatched_stores,\\n        SUM(