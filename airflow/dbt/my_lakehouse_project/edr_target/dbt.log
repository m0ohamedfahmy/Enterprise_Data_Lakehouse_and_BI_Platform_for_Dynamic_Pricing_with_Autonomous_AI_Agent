e", "schema": "elementary"}, {"database": "nessie", "identifier": "model_run_results", "schema": "elementary"}, {"database": "nessie", "identifier": "monitors_runs", "schema": "elementary"}, {"database": "nessie", "identifier": "schema_columns_snapshot", "schema": "elementary"}, {"database": "nessie", "identifier": "seed_run_results", "schema": "elementary"}, {"database": "nessie", "identifier": "snapshot_run_results", "schema": "elementary"}, {"database": "nessie", "identifier": "test_result_rows", "schema": "elementary"}], "schema": "elementary"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "4d423c3d-44da-4848-aa93-08bf49be833f", "level": "debug", "msg": "While listing relations in database=nessie, schema=elementary, found: alerts_anomaly_detection, alerts_dbt_models, alerts_dbt_source_freshness, alerts_dbt_tests, alerts_schema_changes, anomaly_threshold_sensitivity, data_monitoring_metrics, dbt_artifacts_hashes, dbt_columns, dbt_exposures, dbt_groups, dbt_invocations, dbt_metrics, dbt_models, dbt_run_results, dbt_seeds, dbt_snapshots, dbt_source_freshness_results, dbt_sources, dbt_tests, elementary_test_results, job_run_results, metadata, metrics_anomaly_score, model_run_results, monitors_runs, schema_columns_snapshot, seed_run_results, snapshot_run_results, test_result_rows", "name": "ListRelations", "pid": 8119, "thread": "MainThread", "ts": "2026-08-17T12:29:23.461543Z"}}
