{"data": {"args": [], "base_msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    select column_name as column_name\n        ,lower(data_type) as data_type\n        ,character_maximum_length\n        ,numeric_precision\n        ,numeric_scale\n    from information_schema.columns\n        where ilike(table_schema, 'nessie.elementary')\n\n    and ilike(table_name, 'dbt_sources')\n    order by ordinal_position\n  ", "name": "dremio"}, "info": {"category": "", "code": "E001", "extra": {}, "invocation_id": "33053b33-4b37-4b5c-a79a-f51b01d114a0", "level": "debug", "msg": "dremio adapter: On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    select column_name as column_name\n        ,lower(data_type) as data_type\n        ,character_maximum_length\n        ,numeric_precision\n        ,numeric_scale\n    from information_schema.columns\n        where ilike(table_schema, 'nessie.elementary')\n\n    and ilike(table_name, 'dbt_sources')\n    order by ordinal_position\n  ", "name": "AdapterEventDebug", "pid": 40017, "thread": "MainThread", "ts": "2026-07-31T23:44:54.826792Z"}}
