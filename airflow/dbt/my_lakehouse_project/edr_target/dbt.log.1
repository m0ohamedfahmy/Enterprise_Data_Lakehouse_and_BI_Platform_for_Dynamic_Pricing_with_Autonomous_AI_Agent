ts.tags,\n            test_results.test_tags,\n            test_results.model_tags,\n            test_results.meta,\n            test_results.model_meta,\n            case when test_results.invocations_rank_index = 1 then test_results.test_results_query else NULL end as test_results_query,\n            test_results.other,\n            test_results.test_name,\n            test_results.test_params,\n            test_results.severity,\n            test_results.status,\n            test_results.execution_time,\n            test_results.days_diff,\n            test_results.invocations_rank_index,\n            test_results.failures,\n            test_results.result_rows\n        from ordered_test_results as test_results\n        where test_results.invocations_rank_index <= 720\n        order by test_results.elementary_unique_id, test_results.invocations_rank_index desc\n  )\n  \n\n\n  ", "name": "dremio"}, "info": {"category": "", "code": "E001", "extra": {}, "invocation_id": "e4daafac-7b72-4d41-9a95-115955924b7c", "level": "debug", "msg": "dremio adapter: On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"e4daafac-7b72-4d41-9a95-115955924b7c\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n    \n  \n    \n\n  create table \"$scratch\".\"ordered_test_results__tmp_20260731231042327786\"\n   \n  \n  \n  \n  \n\n  \n\n  as (\n    \n        with test_results as (\n            \n    with elementary_test_results as (\n        select * from \"$scratch\".\"elementary_test_results\"\n        \n            where \n     (cast(unix_timestamp(substr(cast((current_timestamp()) as varchar), 1