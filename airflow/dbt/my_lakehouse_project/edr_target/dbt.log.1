{"data": {"args": [], "base_msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n\n      select (case when position('.' in table_schema) > 0\n              then substring(table_schema, 1, position('.' in table_schema) - 1)\n              else table_schema\n          end) as table_catalog\n          ,table_name\n          ,(case when position('.' in table_schema) > 0\n              then substring(table_schema, position('.' in table_schema) + 1)\n              else 'no_schema'\n          end) as table_schema\n          ,lower(table_type) as table_type\n      from information_schema.\"tables\"\n        where ilike(table_schema, '@mofah')\n      and table_type <> 'system_table'\n\n  ", "name": "dremio"}, "info": {"category": "", "code": "E001", "extra": {}, "invocation_id": "32f9b059-b1f6-49a4-9fba-c3b010c5762a", "level": "debug", "msg": "dremio adapter: On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n\n      select (case when position('.' in table_schema) > 0\n              then substring(table_schema, 1, position('.' in table_schema) - 1)\n              else table_schema\n          end) as table_catalog\n          ,table_name\n          ,(case when position('.' in table_schema) > 0\n              then substring(table_schema, position('.' in table_schema) + 1)\n              else 'no_schema'\n          end) as table_schema\n          ,lower(table_type) as table_type\n      from information_schema.\"tables\"\n        where ilike(table_schema, '@mofah')\n      and table_type <> 'system_table'\n\n  ", "name": "AdapterEventDebug", "pid": 38624, "thread": "MainThread", "ts": "2026-07-31T23:30:10.979761Z"}}
