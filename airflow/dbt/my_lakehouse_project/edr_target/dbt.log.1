{"data": {"args": [], "base_msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"e47170e9-60ba-4e47-a30f-ed0ce6ef4f30\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from \"nessie\".\"elementary\".\"model_run_results\"\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as numeric(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n     (cast(unix_timestamp(substr(cast((current_timestamp()) as varchar), 1, 19)) - \n            unix_timestamp(substr(cast((cast(\n        regexp_replace(\n            regexp_replace(\n                regexp_replace(\n                    cast(generated_at as varchar(4096)),\n                    '(\\d)T(\\d)',\n                    '$1 $2'\n                ),\n                '(\\.\\d{3})\\d+',\n                '$1'\n            ),\n            'Z$',\n            ''\n        ) as  timestamp \n    )) as varchar), 1, 19)) as integer) / (60 * 60 * 24))\n    \n < 7\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at\n    \n\n  ", "name": "dremio"}, "info": {"category": "", "code": "E001", "extra": {}, "invocation_id": "e47170e9-60ba-4e47-a30f-ed0ce6ef4f30", "level": "debug", "msg": "dremio adapter: On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.8.9\", \"dbt_dremio_version\": \"1.8.4\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"e47170e9-60ba-4e47-a30f-ed0ce6ef4f30\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from \"nessie\".\"elementary\".\"model_run_results\"\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as numeric(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n     (cast(unix_timestamp(substr(cast((current_timestamp()) as varchar), 1, 19)) - \n            unix_timestamp(substr(cast((cast(\n        regexp_replace(\n            regexp_replace(\n                regexp_replace(\n                    cast(generated_at as varchar(4096)),\n                    '(\\d)T(\\d)',\n                    '$1 $2'\n                ),\n                '(\\.\\d{3})\\d+',\n                '$1'\n            ),\n            'Z$',\n            ''\n        ) as  timestamp \n    )) as varchar), 1, 19)) as integer) / (60 * 60 * 24))\n    \n < 7\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at\n    \n\n  ", "name": "AdapterEventDebug", "pid": 40438, "thread": "MainThread", "ts": "2026-07-31T23:47:11.612207Z"}}
